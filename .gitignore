# Byte-compiled / native
__pycache__/
*.py[cod]
*.so

# Environments. Pixi is the supported one (see pixi.toml); .venv*/ and
# .uv-cache/ catch ad-hoc `uv venv` and editor-created environments.
#
# `.venv*/` and not `.venv`: a fixed name is too narrow, and the previous
# template only caught `.venv` by accident, via its obsolete `lib/` line.
# That accident is what hid a stale 282 MB venv pinned to weightmask 0.1 --
# the same stale tree that made ruff report 3721 errors in CI (see
# tests/test_ci_workflow.py). `.venv-wm` was outside the template's coverage
# and would have become committable the moment `lib/` was removed.
.pixi/
.venv*/
.uv-cache/
.env
venv/
env/

# Build and packaging artifacts
build/
dist/
sdist/
wheels/
parts/
develop-eggs/
*.egg-info/
*.egg
.installed.cfg
MANIFEST
.pypirc

# Test, lint and type caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local data and products. benchmark_data/ holds real MegaCam frames and is not
# redistributed; the tests that need it skip rather than fail without it.
benchmark_data/
test_outputs/
sandbox/
*.weight.fits
*.mask.fits
*.ivar.fits
*.sky.fits

# Scratch
debug_*.py
.jules/

.DS_Store
